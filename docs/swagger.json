  "info": {
    "title": "TikTok Lead Ads -> Bitrix24 CRM",
    "description": "Nhận lead từ TikTok Lead Generation, đồng bộ sang Bitrix24, convert deal theo rule và báo cáo hiệu quả.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "FieldMappingDto": {
        "type": "object",
        "properties": {
          "field_mapping": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Ví dụ { \"lead_data.email\": \"EMAIL[0][VALUE]\" }"
          }
        },
        "required": [
          "field_mapping"
        ]
      },
      "DealRuleDto": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string",
            "description": "Ví dụ: \"campaign.campaign_name CONTAINS 'sale' AND lead.score >= 50\""
          },
          "action": {
            "type": "string",
            "enum": [
              "create_deal"
            ]
          },
          "pipeline_id": {
            "type": "string"
          },
          "stage_id": {
            "type": "string"
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "assigned_to": {
            "type": "object",
            "description": "User ID hoặc mảng user ID (round-robin)"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string"
          }
        },
        "required": [
          "condition",
          "action",
          "pipeline_id",
          "stage_id"
        ]
      },
      "PipelineStageDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "semantic": {
            "type": "string",
            "enum": [
              "won",
              "lost"
            ]
          }
        },
        "required": [
          "id",
          "probability"
        ]
      },
      "RulesDto": {
        "type": "object",
        "properties": {
          "deal_rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DealRuleDto"
            }
          },
          "pipeline_stages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PipelineStageDto"
            }
          }
        },
        "required": [
          "deal_rules"
        ]
      },
      "CampaignSpendDto": {
        "type": "object",
        "properties": {
          "campaign_spend": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "campaign_id -> tổng chi phí (VND)"
          }
        },
        "required": [
          "campaign_spend"
        ]
      },
      "ConvertLeadDto": {
        "type": "object",
        "properties": {
          "pipeline_id": {
            "type": "string"
          },
          "stage_id": {
            "type": "string"
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "assigned_to": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "Lead": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "externalId": {
            "type": "string",
            "description": "event_id của webhook đầu tiên tạo ra lead này."
          },
          "source": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "description": "Số điện thoại chuẩn E.164, ví dụ +84901234567."
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "campaignId": {
            "type": "string",
            "nullable": true
          },
          "campaignName": {
            "type": "string",
            "nullable": true
          },
          "adId": {
            "type": "string",
            "nullable": true
          },
          "adName": {
            "type": "string",
            "nullable": true
          },
          "formId": {
            "type": "string",
            "nullable": true
          },
          "ttclid": {
            "type": "string",
            "nullable": true
          },
          "score": {
            "type": "number",
            "description": "Điểm chất lượng lead 0-100."
          },
          "submissions": {
            "type": "number",
            "description": "Số lần người dùng gửi form (tăng khi bị dedupe)."
          },
          "rawData": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true,
            "description": "Payload gốc của lần submit gần nhất."
          },
          "bitrix24Id": {
            "type": "number",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "synced",
              "converted"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "externalId",
          "source",
          "name",
          "email",
          "phone",
          "city",
          "campaignId",
          "campaignName",
          "adId",
          "adName",
          "formId",
          "ttclid",
          "score",
          "submissions",
          "rawData",
          "bitrix24Id",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "Deal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "leadId": {
            "type": "string",
            "description": "Mỗi lead chỉ convert thành tối đa 1 deal."
          },
          "lead": {
            "$ref": "#/components/schemas/Lead"
          },
          "bitrix24Id": {
            "type": "number",
            "nullable": true
          },
          "title": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "nullable": true
          },
          "currency": {
            "type": "string"
          },
          "pipelineId": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "probability": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "won",
              "lost",
              "open"
            ]
          },
          "assignedTo": {
            "type": "string",
            "nullable": true,
            "description": "ID user Bitrix24 phụ trách deal."
          },
          "closedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "tiktokSyncedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "leadId",
          "bitrix24Id",
          "title",
          "amount",
          "currency",
          "pipelineId",
          "stage",
          "probability",
          "status",
          "assignedTo",
          "closedAt",
          "tiktokSyncedAt",
          "createdAt",
          "updatedAt"
        ]
      },
      "TiktokCampaignDto": {
        "type": "object",
        "properties": {
          "campaign_id": {
            "type": "string",
            "maxLength": 255
          },
          "campaign_name": {
            "type": "string",
            "maxLength": 255
          },
          "ad_id": {
            "type": "string",
            "maxLength": 255
          },
          "ad_name": {
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "TiktokFormDto": {
        "type": "object",
        "properties": {
          "form_id": {
            "type": "string",
            "maxLength": 255
          },
          "form_name": {
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "TiktokLeadDataDto": {
        "type": "object",
        "properties": {
          "full_name": {
            "type": "string",
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "maxLength": 255
          },
          "phone": {
            "type": "string",
            "maxLength": 50
          },
          "city": {
            "type": "string",
            "maxLength": 255
          },
          "interests": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "utm_source": {
            "type": "string",
            "maxLength": 255
          },
          "utm_campaign": {
            "type": "string",
            "maxLength": 255
          },
          "ttclid": {
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "TiktokCustomQuestionDto": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 255
          },
          "answer": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "question",
          "answer"
        ]
      },
      "TiktokWebhookDto": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "description": "lead.generate | form.complete | user.interaction",
            "maxLength": 100
          },
