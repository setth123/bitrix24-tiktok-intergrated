# ---------- App ----------
NODE_ENV=development
PORT=3000
# Header x-api-key cho các API /api/v1/* (để trống = không yêu cầu, CHỈ dùng khi dev)
API_KEY=change-me-api-key
# Quốc gia mặc định khi chuẩn hóa số điện thoại không có mã quốc gia
DEFAULT_PHONE_COUNTRY=VN

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tiktok_bitrix
# Tự chạy migration khi app khởi động
DB_MIGRATIONS_RUN=true
DB_LOGGING=false

# ---------- Redis (cache + BullMQ) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- TikTok ----------
# Secret dùng để ký/kiểm tra header TikTok-Signature
TIKTOK_WEBHOOK_SECRET=change-me-tiktok-secret
TIKTOK_SIGNATURE_TOLERANCE_SEC=300
# mock = chỉ log conversion event; live = gọi TikTok Events API
TIKTOK_MODE=mock
TIKTOK_ACCESS_TOKEN=
TIKTOK_EVENT_SOURCE_ID=

# ---------- Bitrix24 ----------
# mock = Bitrix24 giả lập in-memory; live = gọi REST API qua inbound webhook
BITRIX24_MODE=mock
# VD: https://your-portal.bitrix24.com/rest/1/xxxxxxxxxxxx
BITRIX24_WEBHOOK_URL=
# application_token của outgoing webhook (Bitrix24 -> app)
BITRIX24_APP_TOKEN=change-me-bitrix-token
# User ID nhận deal khi rule không chỉ định assigned_to
BITRIX24_DEFAULT_ASSIGNEE=1

# ---------- Notification ----------
# Incoming webhook (Slack/Google Chat/...) để nhận thông báo & alert. Để trống = chỉ ghi log.
NOTIFY_WEBHOOK_URL=
